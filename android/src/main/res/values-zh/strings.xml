    <!-- About dialog -->
    <string name="about_title">NeoStego</string>
    <string name="about_title_versioned">NeoStego %1$s</string>
    <string name="about_description">在图片或音频中隐藏文件,并嵌入/验证强健的水印。所有处理均在设备本地完成。</string>
    <string name="about_license">基于 Samir Vaidya 开发的 OpenStego。遵循 GNU 通用公共许可证第 2 版授权。</string>
