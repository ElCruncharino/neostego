    <string name="label_file_to_hide">要隐藏的文件</string>
    <string name="hint_file_to_hide">任意文件(文档、照片等)</string>
    <string name="hide_method_title">隐藏方式</string>
    <string name="algo_si_uniward_title">SI-UNIWARD(JPEG)</string>
    <string name="algo_si_uniward_subtitle">侧信息 JPEG 隐写术。输出为 JPEG,在低嵌入率下对抗现代检测器是最强的选择。</string>
    <string name="algo_j_uniward_title">J-UNIWARD(JPEG 载体)</string>
    <string name="algo_j_uniward_subtitle">直接隐藏在现有的 JPEG 中。速度更快,无需原始未压缩图片,但隐蔽性不及 SI-UNIWARD。</string>
    <string name="algo_f5_title">F5(JPEG 载体)</string>
    <string name="algo_f5_subtitle">使用矩阵编码的经典快速 JPEG 隐写术。适合在现有 JPEG 中隐藏少量数据。</string>
    <string name="algo_adaptive_title">自适应(PNG)</string>
    <string name="algo_adaptive_subtitle">HILL + STC:将改动隐藏在纹理区域,同时抵御统计与 AI 隐写分析。输出为无损 PNG,容量较低。</string>
    <string name="algo_lsb_matching_title">LSB 匹配(PNG)</string>
    <string name="algo_lsb_matching_subtitle">容量更大、速度更快,可抵御传统隐写分析。输出为无损 PNG。</string>
    <string name="algo_audio_wav_title">音频(WAV)</string>
    <string name="algo_audio_wav_subtitle">将数据隐藏在未压缩 PCM WAV 文件的采样中。输出为 WAV;请在上方选择音频载体。</string>
    <string name="label_jpeg_quality">JPEG 质量:%1$d</string>
    <string name="hint_jpeg_quality">质量越高图片越清晰,但文件也越大;90 是不错的默认值。</string>
    <string name="btn_advanced_expanded">高级选项 ▴</string>
    <string name="btn_advanced_collapsed">高级选项 ▾</string>
    <string name="label_cluster_changes">聚类更改(CMD)</string>
    <string name="hint_cluster_changes">同步相邻的修改以略微提升抗检测性。除非要复现旧版输出,否则请保持开启。</string>
    <string name="label_clustering_strength">聚类强度(mu):%1$s</string>
    <string name="label_bits_per_channel">每通道比特数:%1$d</string>
    <string name="hint_bits_per_channel">比特数越多可存储的数据越多,但也更易被检测;3 是较好的平衡点。</string>
    <string name="label_compress_payload">压缩数据</string>
    <string name="hint_compress_payload">隐藏前对数据进行 GZIP 压缩。通常能减小体积;若文件已经压缩过,请关闭此选项。</string>
    <string name="label_use_aes256">使用 AES-256</string>
    <string name="hint_use_aes256">密钥长度强于默认的 AES-128。仅在设置了密码时生效。</string>
    <string name="label_split_across_covers">分散到多个载体</string>
    <string name="hint_split_across_covers">将一个文件分散隐藏到多张图片中(请在上方选择 2 张以上)。每张图片保存一部分;需保留全部图片才能提取。</string>
    <string name="label_store_filename">保存原始文件名</string>
    <string name="hint_store_filename">文件名会以未加密方式保存。关闭此项以保护隐私;提取时将使用通用文件名。</string>
    <string name="note_jpeg_share">请原样分享保存的 JPEG。切勿再次打开并重新保存——重新压缩 JPEG 会破坏隐藏的数据。</string>
    <string name="note_wav_share">请原样保存 WAV 文件用于分享。转换为 MP3/AAC 等有损音频格式会破坏隐藏的数据。</string>
    <string name="note_png_share">请原样保存 PNG 文件用于分享。重新保存或以 JPEG 等有损格式发送会破坏隐藏的数据。</string>
