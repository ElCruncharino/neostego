    <string name="label_file_to_hide">要隐藏的文件</string>
    <string name="hint_file_to_hide">任意文件(文档、照片等...)</string>
    <string name="hide_method_title">隐藏方式</string>
    <string name="algo_si_uniward_title">SI-UNIWARD</string>
    <string name="algo_si_uniward_subtitle">抗检测能力最强的JPEG隐写术，输出为JPEG格式</string>
    <string name="algo_j_uniward_title">J-UNIWARD</string>
    <string name="algo_j_uniward_subtitle">将文件直接嵌入JPEG图片中，处理速度更快、不需要无损原图，但抗检测能力不及SI-UNIWARD</string>
    <string name="algo_f5_title">F5</string>
    <string name="algo_f5_subtitle">老牌、速度极快的传统算法，适合在JPEG中隐藏少量数据，抗检测能力一般</string>
    <string name="algo_adaptive_title">Adaptive</string>
    <string name="algo_adaptive_subtitle">结合HILL与STC算法，将数据嵌入图像中复杂纹理和边缘区域，容量较大，抗检测能力极高，输出为PNG格式</string>
    <string name="algo_lsb_matching_title">LSB matching</string>
    <string name="algo_lsb_matching_subtitle">容量较大、速度更快，抗检测能力一般，输出为PNG格式</string>
    <string name="algo_audio_wav_title">Audio(WAV/PCM)</string>
    <string name="algo_audio_wav_subtitle">将文件隐藏到WAV/PCM音频文件中，输出为WAV格式</string>
    <string name="hint_algo_too_small">载体图片太小,无法隐藏所选文件</string>
    <string name="label_jpeg_quality">JPEG质量:%1$d</string>
    <string name="hint_jpeg_quality">质量越高图片越清晰,同时文件相对会更大(建议设置为90)</string>
    <string name="btn_advanced_expanded">高级选项 ▴</string>
    <string name="btn_advanced_collapsed">高级选项 ▾</string>
    <string name="label_cluster_changes">协同更改(CMD)</string>
    <string name="hint_cluster_changes">协同调整相邻像素的修改方向，使修改迹象更加自然，小幅提升防检测能力。除非要复现旧版输出，否则请保持开启</string>
    <string name="label_clustering_strength">协同强度(mu):%1$s</string>
    <string name="label_bits_per_channel">单通道嵌入位数:%1$d</string>
    <string name="hint_bits_per_channel">位数越高可存储的数据越多，抗检测能力会相对更低，建议设置为3</string>
    <string name="label_compress_payload">压缩数据</string>
    <string name="hint_compress_payload">对隐藏文件进行压缩来减小文件体积,若文件已是压缩文件,请关闭此选项。</string>
    <string name="label_use_aes256">启用AES-256加密</string>
    <string name="hint_use_aes256">将默认的AES-128密钥长度翻倍提升至256位(仅在设置了密码时生效)</string>
    <string name="label_split_across_covers">分卷隐藏</string>
    <string name="hint_split_across_covers">将文件分卷隐藏到多个图片中(请在上方选择2张及以上载体图片)，提取文件时需所有分卷齐全</string>
    <string name="label_store_filename">保存原始文件名</string>
    <string name="hint_store_filename">将文件以未加密原始文件名隐藏到载体中。关闭此项以保护隐私，提取时将返回通用的.dat加密文件名</string>
    <string name="note_jpeg_share">请原样保存JPEG文件，重新编辑将会破坏隐藏的数据。</string>
