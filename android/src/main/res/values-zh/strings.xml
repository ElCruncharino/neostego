    <!-- About dialog -->
    <string name="about_title">NeoStego</string>
    <string name="about_title_versioned">NeoStego %1$s</string>
    <string name="about_description">在图片或音频中隐藏文件，并嵌入/验证水印签名。所有处理均在设备本地完成。</string>
    <string name="about_license">基于Samir Vaidya开发的OpenStego。遵循GNU通用公共许可证第2版授权。</string>
    <string name="about_acknowledgement">数字水印签名功能基于萨尔茨堡大学,2001年Peter Meerwald提供的代码(Digital Image Watermarking in the Wavelet Transfer Domain)。</string>
    <string name="btn_close">关闭</string>

