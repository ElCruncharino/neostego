    <string name="label_algorithm">Algorithm</string>
    <string name="algo_dwt_svd_title">DWT-SVD (recommended)</string>
    <string name="algo_dwt_svd_subtitle">Modern blind, multi-bit watermark. Survives JPEG re-compression, noise, blur and small crops.</string>
    <string name="algo_dwt_dugad_title">DWT-Dugad</string>
    <string name="algo_dwt_dugad_subtitle">Classic wavelet spread-spectrum watermark detected by correlation.</string>
    <string name="algo_dwt_xie_title">DWT-Xie</string>
    <string name="algo_dwt_xie_subtitle">Wavelet watermark embedded in the approximation sub-band.</string>
