    <!-- About dialog -->
    <string name="about_title">NeoStego</string>
    <string name="about_title_versioned">NeoStego %1$s</string>
    <string name="about_description">画像や音声にファイルを隠し、堅牢な電子透かしの埋め込みと検証を行います。処理はすべて端末内で完結します。</string>
    <string name="about_license">Samir Vaidya 氏による OpenStego をベースにしています。GNU General Public License v2 のもとで提供されています。</string>
    <string name="about_acknowledgement">デジタル電子透かし機能は Peter Meerwald 氏によるコードを基にしています(Digital Image Watermarking in the Wavelet Transfer Domain, ザルツブルク大学, 2001年)。</string>
    <string name="btn_close">閉じる</string>

