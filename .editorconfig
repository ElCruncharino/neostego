root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# ktlint tuning (used by Spotless). Keep the conservative IntelliJ style and don't fight long
# Compose strings or composable PascalCase naming.
ktlint_code_style = intellij_idea
max_line_length = off
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_filename = disabled

[*.md]
trim_trailing_whitespace = false
