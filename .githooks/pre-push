#!/bin/sh
#
# Pre-push guardrail: run the full formatting check before pushing, since a spotless
# violation slipping to master has broken CI before (see the "unbreak master CI" fixups).
#
# Java/palantir-java-format used to be excluded here: it needs javac internals that only
# exist on the exact JDK it was built against, so it crashed with a confusing
# NoSuchMethodError whenever the JVM launching Gradle wasn't JDK 21 - which happened
# whenever a dev machine's default `java` was some other version, since nothing pinned
# Gradle's own JVM. gradle/gradle-daemon-jvm.properties now pins that (run
# `./gradlew updateDaemonJvm --jvm-version=21` if it's ever missing/wrong), so Gradle always
# launches under JDK 21 regardless of JAVA_HOME/PATH, and both languages are checked here.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for one push:     git push --no-verify

echo "pre-push: checking formatting (spotlessCheck)…"

if ! ./gradlew --quiet spotlessCheck; then
    echo >&2
    echo "✗ Formatting check failed." >&2
    echo "  Fix with:  ./gradlew spotlessApply   then re-commit and push." >&2
    echo "  (Bypass with 'git push --no-verify' if you really must.)" >&2
    exit 1
fi

echo "pre-push: formatting OK."
