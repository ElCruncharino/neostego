#!/bin/sh
#
# Pre-push guardrail: run the Kotlin formatting check before pushing, since a ktlint
# violation slipping to master has broken CI before (see the "unbreak master CI" fixups).
#
# Scope is Kotlin only on purpose: the Java/palantir spotless step needs JDK 16+ module
# exports (--add-exports for jdk.compiler's javac.* packages) that a stale project-local
# .gradle/ cache can silently poison after switching JDKs, producing a confusing
# NoSuchMethodError instead of a real diff. If that happens, `./gradlew --stop && rm -rf
# .gradle` clears it. Given that fragility, Java formatting stays enforced in CI only; this
# hook catches the failure mode that actually recurs locally (Kotlin).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for one push:     git push --no-verify

echo "pre-push: checking Kotlin formatting (spotlessKotlinCheck)…"

if ! ./gradlew --quiet spotlessKotlinCheck; then
    echo >&2
    echo "✗ Kotlin formatting check failed." >&2
    echo "  Fix with:  ./gradlew spotlessKotlinApply   then re-commit and push." >&2
    echo "  (Bypass with 'git push --no-verify' if you really must.)" >&2
    exit 1
fi

echo "pre-push: Kotlin formatting OK."
